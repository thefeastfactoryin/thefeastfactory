// =============================================================================
// FeastFactory canonical Prisma schema
// Purpose: Source of truth for the FeastFactory PostgreSQL database.
// Database target: postgresql://USER:PASSWORD@HOST:PORT/feastfactory?schema=public
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
}

enum AdminRole {
  ADMIN
  OPERATIONS
}

enum AddressType {
  HOME
  OFFICE
  EVENT_VENUE
  OTHER
}

enum CancellationActor {
  CUSTOMER
  ADMIN
}

enum DocumentType {
  PAYMENT_RECEIPT
  GST_INVOICE
  REFUND_CREDIT_NOTE
}

enum PackageType {
  MEAL_BOX
  FIXED_PACKAGE
  CUSTOM_PACKAGE
}

enum OrderingOfferingCode {
  MEAL_BOX
  PACKAGES
  CUSTOM_MENU
}

enum PackageMenuItemRole {
  INCLUDED
  EXTRA
  CUSTOM_SELECTABLE
}

enum SelectedItemRole {
  INCLUDED
  SWAP
  EXTRA
  CUSTOM
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  EXPIRED
}

// =============================================================================
// CUSTOMER DOMAIN
// =============================================================================

model User {
  id           String    @id @default(uuid())
  mobileNumber String    @unique @map("mobile_number") @db.VarChar(15)
  name         String?   @db.VarChar(100)
  email        String?   @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  addresses UserAddress[]
  carts     Cart[]
  orders    Order[]
  documents OrderDocument[]

  @@index([mobileNumber])
  @@index([isActive])
  @@map("users")
}

model UserAddress {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  addressType  AddressType @default(HOME) @map("address_type")
  label        String?     @db.VarChar(50)
  addressLine1 String      @map("address_line1") @db.VarChar(255)
  addressLine2 String?     @map("address_line2") @db.VarChar(255)
  city         String      @db.VarChar(100)
  state        String      @db.VarChar(100)
  pincode      String      @db.VarChar(10)
  landmark     String?     @db.VarChar(255)
  latitude     Decimal?    @db.Decimal(10, 8)
  longitude    Decimal?    @db.Decimal(11, 8)
  isDefault    Boolean     @default(false) @map("is_default")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id])
  carts  Cart[]
  orders Order[]

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_addresses")
}

// =============================================================================
// MENU DOMAIN
// =============================================================================

model MenuCategory {
  id           String   @id @default(uuid())
  name         String   @unique @db.VarChar(100)
  description  String?  @db.VarChar(500)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  menuItems          MenuItem[]
  packageMenuItems   PackageMenuItem[]
  cartItems          CartItem[]
  orderSelectedItems OrderSelectedItem[]

  @@index([isActive])
  @@map("menu_categories")
}

model MenuItem {
  id           String    @id @default(uuid())
  categoryId   String    @map("category_id")
  name         String    @db.VarChar(150)
  description  String?   @db.VarChar(1000)
  boxPrice     Decimal   @map("box_price") @db.Decimal(10, 2)
  generalPrice Decimal   @map("general_price") @db.Decimal(10, 2)
  isVeg        Boolean   @default(true) @map("is_veg")
  isActive     Boolean   @default(true) @map("is_active")
  imageUrl     String?   @map("image_url") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  category                  MenuCategory        @relation(fields: [categoryId], references: [id])
  packageMenuItems          PackageMenuItem[]
  cartItems                 CartItem[]          @relation("CartItemMenuItem")
  replacedInCartItems       CartItem[]          @relation("CartItemReplacedMenuItem")
  orderSelectedItems        OrderSelectedItem[] @relation("OrderSelectedMenuItem")
  replacedInOrderSelections OrderSelectedItem[] @relation("OrderSelectedReplacedMenuItem")

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
  @@map("menu_items")
}

// =============================================================================
// PACKAGE DOMAIN
// =============================================================================

model Package {
  id           String      @id @default(uuid())
  name         String      @unique @db.VarChar(100)
  description  String?     @db.VarChar(1000)
  type         PackageType @default(FIXED_PACKAGE)
  isActive     Boolean     @default(true) @map("is_active")
  displayOrder Int         @default(0) @map("display_order")
  isFeatured  Boolean      @default(false) @map("is_featured")
  featuredOrder Int?       @map("featured_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  versions PackageVersion[]

  @@index([type])
  @@index([isActive])
  @@index([isFeatured, featuredOrder])
  @@map("packages")
}

model OrderingOffering {
  id           String               @id @default(uuid())
  code         OrderingOfferingCode @unique
  title        String               @db.VarChar(100)
  description  String               @db.VarChar(500)
  displayOrder Int                  @default(0) @map("display_order")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("ordering_offerings")
}

model PackageVersion {
  id                String    @id @default(uuid())
  packageId         String    @map("package_id")
  versionNo         Int       @map("version_no")
  basePricePerPlate Decimal   @map("base_price_per_plate") @db.Decimal(10, 2)
  minGuestCount     Int       @default(10) @map("min_guest_count")
  maxGuestCount     Int?      @map("max_guest_count")
  isActive          Boolean   @default(true) @map("is_active")
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  package          Package           @relation(fields: [packageId], references: [id])
  packageMenuItems PackageMenuItem[]
  carts            Cart[]

  @@unique([packageId, versionNo])
  @@index([packageId, isActive])
  @@map("package_versions")
}

model PackageMenuItem {
  id               String              @id @default(uuid())
  packageVersionId String              @map("package_version_id")
  categoryId       String              @map("category_id")
  menuItemId       String              @map("menu_item_id")
  role             PackageMenuItemRole
  isAvailable      Boolean             @default(true) @map("is_available")
  isSwappable      Boolean             @default(false) @map("is_swappable")
  displayOrder     Int                 @default(0) @map("display_order")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")

  packageVersion PackageVersion @relation(fields: [packageVersionId], references: [id])
  category       MenuCategory   @relation(fields: [categoryId], references: [id])
  menuItem       MenuItem       @relation(fields: [menuItemId], references: [id])

  @@unique([packageVersionId, menuItemId, role])
  @@index([packageVersionId, role])
  @@index([packageVersionId, categoryId])
  @@map("package_menu_items")
}

// =============================================================================
// CART DOMAIN
// =============================================================================

model Cart {
  id               String     @id @default(uuid())
  userId           String     @map("user_id")
  packageVersionId String     @map("package_version_id")
  addressId        String?    @map("address_id")
  regionId         String?    @map("region_id")
  eventName        String?    @map("event_name") @db.VarChar(200)
  eventDate        DateTime?  @map("event_date") @db.Date
  eventTimeStart   DateTime?  @map("event_time_start") @db.Time
  guestCount       Int?       @map("guest_count")
  distanceKm       Decimal?   @map("distance_km") @db.Decimal(8, 2)
  deliveryFee      Decimal    @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  specialNotes     String?    @map("special_notes") @db.VarChar(1000)
  status           CartStatus @default(ACTIVE)
  expiresAt        DateTime?  @map("expires_at")
  lastQuotedAt     DateTime?  @map("last_quoted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id])
  packageVersion PackageVersion   @relation(fields: [packageVersionId], references: [id])
  address        UserAddress?     @relation(fields: [addressId], references: [id])
  region         OperatingRegion? @relation(fields: [regionId], references: [id])
  items          CartItem[]
  order          Order?

  @@index([userId, status])
  @@index([packageVersionId])
  @@index([addressId])
  @@index([regionId, eventDate])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id                 String           @id @default(uuid())
  cartId             String           @map("cart_id")
  categoryId         String           @map("category_id")
  menuItemId         String           @map("menu_item_id")
  replacedMenuItemId String?          @map("replaced_menu_item_id")
  role               SelectedItemRole
  quantity           Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  cart             Cart         @relation(fields: [cartId], references: [id])
  category         MenuCategory @relation(fields: [categoryId], references: [id])
  menuItem         MenuItem     @relation("CartItemMenuItem", fields: [menuItemId], references: [id])
  replacedMenuItem MenuItem?    @relation("CartItemReplacedMenuItem", fields: [replacedMenuItemId], references: [id])

  @@index([cartId])
  @@index([cartId, role])
  @@index([categoryId])
  @@index([menuItemId])
  @@index([replacedMenuItemId])
  @@map("cart_items")
}

// =============================================================================
// ORDER DOMAIN
// =============================================================================

model Order {
  id          String  @id @default(uuid())
  orderNumber String  @unique @map("order_number") @db.VarChar(20)
  userId      String  @map("user_id")
  cartId      String? @unique @map("cart_id")
  regionId    String? @map("region_id")
  addressId   String  @map("address_id")

  eventName      String?   @map("event_name") @db.VarChar(200)
  eventDate      DateTime  @map("event_date") @db.Date
  eventTimeStart DateTime? @map("event_time_start") @db.Time
  specialNotes   String?   @map("special_notes") @db.VarChar(1000)

  guestCount                Int      @map("guest_count")
  basePerPlatePrice         Decimal  @map("base_per_plate_price") @db.Decimal(10, 2)
  totalCustomizationCharges Decimal  @default(0) @map("total_customization_charges") @db.Decimal(10, 2)
  finalPerPlatePrice        Decimal  @map("final_per_plate_price") @db.Decimal(10, 2)
  totalAmount               Decimal  @map("total_amount") @db.Decimal(10, 2)
  distanceKm                Decimal? @map("distance_km") @db.Decimal(8, 2)
  deliveryFee               Decimal  @default(0) @map("delivery_fee") @db.Decimal(10, 2)

  packageName      String @map("package_name") @db.VarChar(100)
  packageVersionNo Int    @map("package_version_no")

  orderStatus   OrderStatus   @default(DRAFT) @map("order_status")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  cancelledAt        DateTime?          @map("cancelled_at")
  cancelledBy        CancellationActor? @map("cancelled_by")
  cancellationReason String?            @map("cancellation_reason") @db.VarChar(500)
  cancelledByAdminId String?            @map("cancelled_by_admin_id")
  bookingLeadHours   Int?               @map("booking_lead_hours")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  user             User                 @relation(fields: [userId], references: [id])
  address          UserAddress          @relation(fields: [addressId], references: [id])
  cart             Cart?                @relation(fields: [cartId], references: [id])
  region           OperatingRegion?     @relation(fields: [regionId], references: [id])
  selectedItems    OrderSelectedItem[]
  payments         Payment[]
  statusHistory    OrderStatusHistory[]
  notes            OrderNote[]
  documents        OrderDocument[]
  cancelledByAdmin AdminUser?           @relation("OrderCancelledByAdmin", fields: [cancelledByAdminId], references: [id])

  @@index([orderNumber])
  @@index([userId])
  @@index([addressId])
  @@index([eventDate])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([regionId, orderStatus])
  @@index([regionId, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

model OrderSelectedItem {
  id                 String           @id @default(uuid())
  orderId            String           @map("order_id")
  categoryId         String           @map("category_id")
  menuItemId         String           @map("menu_item_id")
  replacedMenuItemId String?          @map("replaced_menu_item_id")
  role               SelectedItemRole

  menuItemName         String   @map("menu_item_name") @db.VarChar(150)
  categoryName         String   @map("category_name") @db.VarChar(100)
  replacedMenuItemName String?  @map("replaced_menu_item_name") @db.VarChar(150)
  isVeg                Boolean  @map("is_veg")
  itemPrice            Decimal  @map("item_price") @db.Decimal(10, 2)
  includedValue        Decimal  @map("included_value") @db.Decimal(10, 2)
  adjustmentAmount     Decimal  @default(0) @map("adjustment_amount") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at")

  order            Order        @relation(fields: [orderId], references: [id])
  category         MenuCategory @relation(fields: [categoryId], references: [id])
  menuItem         MenuItem     @relation("OrderSelectedMenuItem", fields: [menuItemId], references: [id])
  replacedMenuItem MenuItem?    @relation("OrderSelectedReplacedMenuItem", fields: [replacedMenuItemId], references: [id])

  @@index([orderId])
  @@index([orderId, categoryId])
  @@index([role])
  @@index([menuItemId])
  @@index([replacedMenuItemId])
  @@map("order_selected_items")
}

// =============================================================================
// PAYMENT DOMAIN
// =============================================================================

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  razorpayOrderId   String?   @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?   @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature String?   @map("razorpay_signature") @db.VarChar(500)
  gatewayResponse   Json?     @map("gateway_response")
  paymentMethod     String?   @map("payment_method") @db.VarChar(50)
  paidAt            DateTime? @map("paid_at")
  failureReason     String?   @map("failure_reason") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  order     Order           @relation(fields: [orderId], references: [id])
  refunds   Refund[]
  documents OrderDocument[]

  @@index([orderId])
  @@index([paymentStatus])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String       @map("payment_id")
  amount           Decimal      @db.Decimal(10, 2)
  refundStatus     RefundStatus @default(INITIATED) @map("refund_status")
  razorpayRefundId String?      @map("razorpay_refund_id") @db.VarChar(100)
  reason           String?      @db.VarChar(500)
  initiatedById    String?      @map("initiated_by_id")
  gatewayResponse  Json?        @map("gateway_response")
  initiatedAt      DateTime     @default(now()) @map("initiated_at")
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  payment   Payment         @relation(fields: [paymentId], references: [id])
  documents OrderDocument[]

  @@index([paymentId])
  @@index([refundStatus])
  @@index([razorpayRefundId])
  @@map("refunds")
}

// =============================================================================
// ADMINISTRATION AND OPERATIONS
// =============================================================================

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(100)
  role         AdminRole
  regionId     String?   @map("region_id")
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  orderStatusHistory OrderStatusHistory[]
  cancelledOrders    Order[]              @relation("OrderCancelledByAdmin")
  orderNotes         OrderNote[]
  region             OperatingRegion?     @relation(fields: [regionId], references: [id])

  @@index([email])
  @@index([isActive])
  @@index([regionId])
  @@map("admin_users")
}

model OperatingRegion {
  id               String   @id @default(uuid())
  code             String   @unique @db.VarChar(40)
  name             String   @db.VarChar(100)
  centerLatitude   Decimal  @map("center_latitude") @db.Decimal(10, 8)
  centerLongitude  Decimal  @map("center_longitude") @db.Decimal(11, 8)
  serviceRadiusKm  Decimal  @default(50) @map("service_radius_km") @db.Decimal(8, 2)
  deliveryFeePerKm Decimal  @default(10) @map("delivery_fee_per_km") @db.Decimal(10, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  admins AdminUser[]
  carts  Cart[]
  orders Order[]

  @@index([isActive])
  @@map("operating_regions")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by_id")
  notes       String?      @db.VarChar(500)
  changedAt   DateTime     @default(now()) @map("changed_at")

  order     Order      @relation(fields: [orderId], references: [id])
  changedBy AdminUser? @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@index([orderId, changedAt])
  @@map("order_status_history")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  providerEventId String    @unique @map("provider_event_id") @db.VarChar(150)
  eventType       String    @map("event_type") @db.VarChar(100)
  payload         Json
  processedAt     DateTime? @map("processed_at")
  processingError String?   @map("processing_error") @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([eventType])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  authorId  String   @map("author_id")
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  order  Order     @relation(fields: [orderId], references: [id])
  author AdminUser @relation(fields: [authorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model OrderDocument {
  id             String       @id @default(uuid())
  orderId        String       @map("order_id")
  userId         String       @map("user_id")
  paymentId      String?      @map("payment_id")
  refundId       String?      @map("refund_id")
  documentType   DocumentType @map("document_type")
  documentNumber String       @unique @map("document_number") @db.VarChar(50)
  snapshot       Json
  generatedAt    DateTime     @default(now()) @map("generated_at")

  order   Order    @relation(fields: [orderId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  refund  Refund?  @relation(fields: [refundId], references: [id])

  @@index([orderId, documentType])
  @@index([userId, generatedAt])
  @@map("order_documents")
}

// =============================================================================
// PLATFORM CONFIGURATION
// =============================================================================

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String   @db.VarChar(500)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model OtpVerification {
  id           String   @id @default(uuid())
  mobileNumber String   @map("mobile_number") @db.VarChar(15)
  otpHash      String   @map("otp_hash") @db.VarChar(255)
  attempts     Int      @default(0)
  isVerified   Boolean  @default(false) @map("is_verified")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([mobileNumber, isVerified])
  @@index([expiresAt])
  @@map("otp_verifications")
}
